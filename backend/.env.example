# Local Postgres (default for this dev container):
DATABASE_URL="postgresql://emaal:emaal_dev_pw@localhost:5432/emaal_wallet"
# Supabase project "emaal-wallet" (ref: loogwzoticnpmfkfbsyr) — schema already migrated.
# Get the password from Supabase dashboard > emaal-wallet > Project Settings > Database,
# then swap it in for local Postgres above. Use the connection POOLER (port 6543), not the
# direct host (port 5432): the direct host is IPv6-only and unreachable from IPv4-only
# serverless platforms like Vercel.
# DATABASE_URL="postgresql://postgres.loogwzoticnpmfkfbsyr:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
JWT_SECRET="change-me-to-a-long-random-value-in-production"
PORT=4000
NODE_ENV="development"
# Threshold in whole USD above which a transaction is routed to the manual approval queue
APPROVAL_THRESHOLD_USD=5000
# Webhook HMAC signing secret base (per-partner secrets are derived/stored separately)
WEBHOOK_SIGNING_ALGO="sha256"
